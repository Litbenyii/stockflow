---
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>StockFlow</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: white;
      }

      section {
        padding: 80px 20px;
        max-width: 1000px;
        margin: auto;
      }

      h1, h2 {
        text-align: center;
      }

      .hero {
        text-align: center;
        padding: 120px 20px;
      }

      .hero h1 {
        font-size: 3rem;
      }

      .btn {
        padding: 12px 24px;
        margin: 10px;
        background: #22c55e;
        color: black;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
      }

      .card {
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
      }
    </style>
  </head>

  <body>

    <!-- HERO -->
    <section class="hero">
      <h1>StockFlow</h1>
      <p>Sistema inteligente de gestión de inventario en tiempo real</p>
      <a class="btn" href="#">Ver demo</a>
      <a class="btn" href="#">Conocer más</a>
    </section>

    <!-- PROBLEMA -->
    <section>
      <h2>El problema</h2>
      <div class="grid">
        <div class="card">❌ Diferencias en stock</div>
        <div class="card">❌ Procesos manuales</div>
        <div class="card">❌ Falta de integración</div>
        <div class="card">❌ Decisiones por intuición</div>
      </div>
    </section>

    <!-- SOLUCIÓN -->
    <section>
      <h2>La solución</h2>
      <p style="text-align:center;">
        Un sistema integrado que conecta bodega, ventas e inventario en tiempo real.
      </p>
    </section>

    <!-- FUNCIONALIDADES -->
    <section>
      <h2>Funcionalidades</h2>
      <div class="grid">
        <div class="card">📦 Control de inventario</div>
        <div class="card">💰 Integración con ventas</div>
        <div class="card">🔄 Movimientos internos</div>
        <div class="card">📊 Reportes automáticos</div>
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section>
      <h2>Beneficios</h2>
      <div class="grid">
        <div class="card">🚀 Menos pérdidas</div>
        <div class="card">⏱ Ahorro de tiempo</div>
        <div class="card">📊 Decisiones inteligentes</div>
        <div class="card">🔍 Mayor control</div>
      </div>
    </section>

  </body>
</html>
