---
import Layout from "../layouts/Layout.astro";
---

<Layout>

<nav>
  <a href="#demo">Demo</a>
  <a href="#problema">Problema</a>
  <a href="#solucion">Solución</a>
  <a href="#funcionalidades">Funciones</a>
  <a href="#beneficios">Beneficios</a>
</nav>

<section class="hero">
  <div class="hero-box">
    <h1>Stock<span class="highlight">Flow</span></h1>

    <p class="hero-big">
      Sistema inteligente de inventario para retail moderno
    </p>

    <p class="hero-small">
      Controla, automatiza y escala tu negocio con datos en tiempo real
    </p>

    <p class="subtitle">
      Optimiza tu operación, elimina errores y toma decisiones con datos reales.
    </p>

    <div class="buttons">
      <a class="btn primary" href="#demo">Ver demo</a>
      <a class="btn secondary" href="#problema">Ver problema</a>
    </div>
  </div>
</section>

<section id="demo" class="demo-section">
  <h2>Así funciona StockFlow en la práctica</h2>

  <div class="demo-video">
    <div class="play">▶</div>
  </div>

  <p class="demo-text">
    Visualiza en tiempo real el estado de tu inventario, movimientos y ventas.
  </p>

  <div class="dashboard">
    <div class="dashboard-header">
      <span>StockFlow Dashboard</span>
      <div class="dots">
        <div></div><div></div><div></div>
      </div>
    </div>

    <div class="dashboard-body">
      <div class="dashboard-card">
        <h3>Stock total</h3>
        <p class="big">1.248</p>
      </div>

      <div class="dashboard-card">
        <h3>Ventas hoy</h3>
        <p class="big">87</p>
      </div>

      <div class="dashboard-card">
        <h3>Productos críticos</h3>
        <p class="big red">12</p>
      </div>

      <div class="dashboard-card wide">
        <h3>Actividad reciente</h3>
        <ul>
          <li>+12 Nike Tech ingresados</li>
          <li>-3 Hoodies vendidos</li>
          <li>Stock actualizado automáticamente</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="problema" class="problem-hero parallax" data-speed="0.15">
  <div class="problem-overlay">
    <h2>El problema real del retail</h2>

    <p>
      El control de inventario en retail sigue siendo uno de los mayores puntos débiles del negocio.
      Muchas empresas operan con procesos manuales, sistemas desconectados y sin visibilidad en tiempo real.
    </p>

    <div class="problem-list">
      <div class="problem-item">
        ❌ <strong>Diferencias de stock</strong><br />
        Productos faltantes o duplicados al recibir mercadería.
      </div>

      <div class="problem-item">
        ⚠️ <strong>Procesos manuales</strong><br />
        Registro por planillas o sin control por unidad.
      </div>

      <div class="problem-item">
        🔗 <strong>Sistemas desconectados</strong><br />
        Bodega y ventas no comparten información.
      </div>

      <div class="problem-item">
        📉 <strong>Falta de visibilidad</strong><br />
        No se sabe el stock real disponible.
      </div>

      <div class="problem-item">
        🧠 <strong>Decisiones sin datos</strong><br />
        Reposición basada en intuición.
      </div>
    </div>

    <p class="impact-text">
      💥 Todo esto genera pérdidas económicas, quiebres de stock y mala experiencia para el cliente.
    </p>
  </div>
</section>

<section class="fade">
  <h2>¿Por qué ocurre esto?</h2>
  <div class="grid">
    <div class="card">Falta de integración</div>
    <div class="card">Procesos antiguos</div>
    <div class="card">Error humano</div>
    <div class="card">Falta de tecnología</div>
  </div>
</section>

<section id="solucion" class="fade">
  <h2>La solución: StockFlow</h2>
  <div class="grid">
    <div class="card">Inventario en tiempo real</div>
    <div class="card">Integración con ventas</div>
    <div class="card">Movimientos controlados</div>
    <div class="card">Inteligencia de datos</div>
  </div>
</section>

<section id="funcionalidades" class="fade">
  <h2>Funcionalidades</h2>
  <div class="grid">
    <div class="card">Inventario</div>
    <div class="card">Ventas</div>
    <div class="card">Movimientos</div>
    <div class="card">Reportes</div>
  </div>
</section>

<section id="beneficios" class="fade">
  <h2>Beneficios</h2>
  <div class="grid">
    <div class="card">Menos pérdidas</div>
    <div class="card">Más eficiencia</div>
    <div class="card">Mejor decisión</div>
    <div class="card">Control total</div>
  </div>
</section>

<section class="cta">
  <h2>¿Listo para dejar de perder dinero?</h2>

  <div class="cta-buttons">
    <button class="btn primary">Solicitar demo</button>
    <button class="btn secondary">WhatsApp</button>
  </div>
</section>

<div class="cursor-glow"></div>

<div id="debug-panel">
  <strong>StockFlow Debug</strong>
  <div id="debug-lines"></div>
</div>

<script is:inline>
  (function () {
    const linesEl = document.getElementById("debug-lines");

    function addLine(text, ok = true) {
      if (!linesEl) return;
      const row = document.createElement("div");
      row.style.marginTop = "4px";
      row.style.color = ok ? "#86efac" : "#fca5a5";
      row.textContent = (ok ? "✅ " : "❌ ") + text;
      linesEl.appendChild(row);
    }

    function addWarn(text) {
      if (!linesEl) return;
      const row = document.createElement("div");
      row.style.marginTop = "4px";
      row.style.color = "#fcd34d";
      row.textContent = "⚠️ " + text;
      linesEl.appendChild(row);
    }

    window.addEventListener("error", function (e) {
      addLine("Error global: " + (e.message || "desconocido"), false);
    });

    window.addEventListener("unhandledrejection", function (e) {
      addLine("Promise rechazada", false);
    });

    document.addEventListener("DOMContentLoaded", function () {
      addLine("HTML cargó");

      const dashboard = document.querySelector(".dashboard");
      addLine("Dashboard encontrado: " + !!dashboard, !!dashboard);

      const fadeCount = document.querySelectorAll(".fade").length;
      addLine("Secciones .fade: " + fadeCount, true);

      const cards = document.querySelectorAll(".card").length;
      addLine("Cards encontradas: " + cards, true);

      const nav = document.querySelector("nav");
      addLine("Nav encontrado: " + !!nav, !!nav);

      const bodyBg = getComputedStyle(document.body).backgroundColor;
      addLine("CSS aplicado en body: " + bodyBg, bodyBg !== "rgba(0, 0, 0, 0)");

      if (dashboard) {
        const dashboardStyles = getComputedStyle(dashboard);
        addLine(
          "Dashboard bg: " + dashboardStyles.backgroundColor,
          dashboardStyles.backgroundColor !== "rgba(0, 0, 0, 0)"
        );
      }

      setTimeout(() => {
        if (window.__stockflowMainLoaded) {
          addLine("main.js cargó correctamente");
        } else {
          addLine("main.js NO cargó", false);
        }

        if (document.documentElement.classList.contains("js")) {
          addLine("Clase .js aplicada al <html>");
        } else {
          addWarn("Clase .js no aplicada");
        }

        const firstFade = document.querySelector(".fade");
        if (firstFade) {
          const fadeStyles = getComputedStyle(firstFade);
          addLine(
            "Primer .fade opacity: " + fadeStyles.opacity,
            true
          );
        }
      }, 800);
    });
  })();
</script>

<style is:inline>
  #debug-panel {
    position: fixed;
    right: 16px;
    bottom: 16px;
    width: 320px;
    max-height: 60vh;
    overflow: auto;
    background: rgba(2, 6, 23, 0.92);
    color: white;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 14px;
    z-index: 99999;
    font: 12px/1.4 -apple-system, BlinkMacSystemFont, sans-serif;
    box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    backdrop-filter: blur(10px);
  }
</style>

</Layout>